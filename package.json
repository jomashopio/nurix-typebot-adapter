{
  "name": "@jomashopio/nurix-typebot-adapter",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP-to-WebSocket session adapter connecting Typebot Forge actions to Nurix Chat",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "npm run security:check && npm run format:check && npm run typecheck && npm test",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "security:check": "node scripts/check-repository.mjs",
    "start": "node dist/src/server.js",
    "test": "npm run build && node --test \"dist/test/*.test.js\" \"test/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jomashopio/nurix-typebot-adapter.git"
  },
  "bugs": {
    "url": "https://github.com/jomashopio/nurix-typebot-adapter/issues"
  },
  "homepage": "https://github.com/jomashopio/nurix-typebot-adapter#readme",
  "license": "UNLICENSED",
  "dependencies": {
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.7",
    "@types/node": "26.4.0",
    "@types/ws": "8.18.1",
    "typescript": "5.9.3"
  }
}
