:8080 {
	header {
		Cache-Control "no-store"
		X-Content-Type-Options "nosniff"
	}

	handle /health/live {
		header Content-Type "application/json"
		respond `{"status":"ok"}` 200
	}

	handle /health/ready {
		reverse_proxy {$ADAPTER_UPSTREAM} {
			header_up -Authorization
			header_up -Cookie
			header_up -Idempotency-Key
			header_up -X-Adapter-Gateway-Secret
			header_up -X-Nurix-Gateway-Api-Key
		}
	}

	@messages {
		method POST
		path /v1/messages
	}
	handle @messages {
		request_body {
			max_size 65536
		}
		reverse_proxy {$ADAPTER_UPSTREAM} {
			header_up X-Adapter-Gateway-Secret {$GATEWAY_SHARED_SECRET}
			header_up -Cookie
			transport http {
				dial_timeout 10s
				response_header_timeout 90s
			}
		}
	}

	@messagesWrongMethod path /v1/messages
	handle @messagesWrongMethod {
		header Allow "POST"
		header Content-Type "application/json"
		respond `{"error":{"code":"METHOD_NOT_ALLOWED","message":"Method not allowed"}}` 405
	}

	handle {
		header Content-Type "application/json"
		respond `{"error":{"code":"NOT_FOUND","message":"Route not found"}}` 404
	}
}
